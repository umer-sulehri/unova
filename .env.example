# Admin panel password (change this in production)
ADMIN_PASSWORD=change-me

# Canonical origin for metadataBase, canonical URLs, Open Graph tags and sitemap.xml.
# Set this to the real production domain (no trailing slash) before going live.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Supabase (Project Settings > API in your Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
