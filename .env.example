# Admin panel password (change this in production)
ADMIN_PASSWORD=change-me

# Canonical origin for metadataBase, canonical URLs, Open Graph tags and sitemap.xml.
# Set this to the real production domain (no trailing slash) before going live.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Supabase (Project Settings > API in your Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# WhatsApp alerts for new contact queries (optional)
# Option A — quick personal WhatsApp messages via CallMeBot:
#   1. Save +34 644 66 32 62 as a contact on your phone.
#   2. Send it: "I allow callmebot to send me messages"
#   3. It replies with an API key.
# WHATSAPP_NOTIFY_PHONE must include the country code, digits only.
CALLMEBOT_API_KEY=
WHATSAPP_NOTIFY_PHONE=

# Option B — POST each query to Zapier / Make / n8n / your own webhook.
# The payload is JSON: { type, siteName, to, text, message }.
WHATSAPP_WEBHOOK_URL=
